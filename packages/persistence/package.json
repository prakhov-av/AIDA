{
  "name": "@aida/persistence",
  "version": "0.1.0",
  "description": "AIDA Concrete Persistence Infrastructure",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aida/domain": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "rimraf": "^6",
    "tsup": "^8",
    "typescript": "^5.9",
    "vitest": "^3"
  }
}